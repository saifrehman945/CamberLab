# =========================================================================
# CamberLab — .gitignore
#
# Strategy: track the reproducibility kernel only.
#   Tracked  → scripts/, openfoam_template/, samples.csv, train/test_idx.npy,
#              validation/, requirements.txt, .python-version,
#              README*.md, CLAUDE.md,
#              (future) results/summary.csv, models/*.joblib
#   Ignored  → cases/  (1.9 GB of meshes, fields, logs — regenerable from
#              the tracked inputs above via scripts/02..04).
# =========================================================================

# --- Bulk CFD case data (kept locally, never committed) ------------------
# Includes per-case meshes, polyMesh, time-step fields, postProcessing,
# OpenFOAM logs, and validation cases. All regenerable from scripts/ +
# openfoam_template/ + samples.csv.
cases/

# --- OpenFOAM stray artifacts (defensive, if any leak outside cases/) ----
processor*/
*.foam
*.vtu
*.vtk
log.simpleFoam
log.foamRun
log.checkMesh
log.gmshToFoam
log.potentialFoam
log.yPlus
*.pre_harden

# --- Python --------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/

# --- Virtual environments / secrets --------------------------------------
.env
.venv/
venv/

# --- Editor / IDE --------------------------------------------------------
*.swp
*.swo

# --- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- LLM/models ---------------------------------------------------------
.claude/
.codex
.agents
# --- Downloaded datasets (AirfRANS; user-managed, never committed) -------
data/

# --- Surrogate artifacts ---------------------------------------------------
# Only models/full/ (used by the app, CLI and demo) is committed. The other
# task model sets are ~100 MB of pickles; regenerate them with
#   uv run python scripts/09_train_surrogates.py --task all
models/scarce/
models/reynolds/
models/aoa/
# Curve models for full: only PCA, GP and MLP are committed (~100 MB). The
# per-mode KRG (~700 MB) and multi-output RF (~170 MB) curve models are
# regenerated with
#   uv run python scripts/09_train_surrogates.py --task full --outputs curves
models/full/curves/krg_*.joblib
models/full/curves/rf_*.joblib

# Native wall nodes per sample (ragged, ~100 MB); regenerate with
#   uv run python scripts/20_ingest_airfrans.py
results/airfrans_wall_native.npz
