FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform {{ OMEGAINF }};

boundaryField
{
    freestream
    {
        type            inletOutlet;
        inletValue      uniform {{ OMEGAINF }};
        value           uniform {{ OMEGAINF }};
    }

    aerofoil
    {
        type            omegaWallFunction;
        value           uniform {{ OMEGAINF }};
    }

    frontAndBack
    {
        type            empty;
    }
}

