FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform {{ KINF }};

boundaryField
{
    freestream
    {
        type            inletOutlet;
        inletValue      uniform {{ KINF }};
        value           uniform {{ KINF }};
    }

    aerofoil
    {
        type            kLowReWallFunction;
        value           uniform 1e-10;
    }

    frontAndBack
    {
        type            empty;
    }
}

