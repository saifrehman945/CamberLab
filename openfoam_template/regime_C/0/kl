FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      kl;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// kkLOmega LAMINAR kinetic energy. Zero everywhere at initialisation and in
// the freestream — laminar KE is a pre-transitional quantity generated only
// inside the boundary layer by the model, so there is no free-stream source.
// Static (α/Re-independent); matches the elipsekkLOmega tutorial.

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    freestream
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }

    aerofoil
    {
        type            fixedValue;
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
}

