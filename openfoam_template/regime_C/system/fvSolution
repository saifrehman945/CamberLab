FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Regime C (transitional, kkLOmega, SIMPLEC). Relaxation kept conservative:
// the mesh carries many near-70-deg non-orthogonal faces (stiff pressure
// system) and the kt/kl/omega transition balance is sensitive to large
// corrections. An aggressive p=0.7/U=0.8 trial survived only the benign alpha=0
// probe; Regime B diverged outright on comparable values, so C is dialled back
// pre-emptively to a stable band (p 0.5, U 0.7, turbulence 0.5). Raise only
// after higher-alpha probes are confirmed stable. nNonOrthogonalCorrectors = 2.

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-08;
        relTol          0.01;
    }

    "(U|kt|kl|omega)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-08;
        relTol          0.1;
    }

    Phi
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-06;
        relTol          0.01;
    }
}

potentialFlow
{
    nNonOrthogonalCorrectors 5;
}

SIMPLE
{
    nNonOrthogonalCorrectors 2;
    consistent               yes;

    residualControl
    {
        p               1e-5;
        U               1e-5;
        kt              1e-5;
        kl              1e-5;
        omega           1e-5;
    }
}

relaxationFactors
{
    fields
    {
        p               0.5;
    }

    equations
    {
        U               0.7;
        kt              0.5;
        kl              0.5;
        omega           0.5;
    }
}

cache
{
    grad(U);
}

