FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Regime C (transitional, kkLOmega). Like B, walls are fully resolved
// (y+<1) so U/p are pre-conditioned by potentialFoam and relaxation is kept
// conservative — the kt/kl/omega transition balance is sensitive to large
// corrections. Relaxation matches B (A's 0.7/0.3 scaled by 0.7).
// nNonOrthogonalCorrectors = 2 because C's mesh is gated at
// non-orthogonality < 90 deg (REGIME_MESH["C"], like B).

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-08;
        relTol          0.01;
    }

    "(U|kt|kl|omega)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-08;
        relTol          0.1;
    }

    Phi
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-06;
        relTol          0.01;
    }
}

potentialFlow
{
    nNonOrthogonalCorrectors 5;
}

SIMPLE
{
    nNonOrthogonalCorrectors 2;
    consistent               yes;

    residualControl
    {
        p               1e-5;
        U               1e-5;
        kt              1e-5;
        kl              1e-5;
        omega           1e-5;
    }
}

relaxationFactors
{
    fields
    {
        p               0.21;
    }

    equations
    {
        U               0.49;
        kt              0.49;
        kl              0.49;
        omega           0.49;
    }
}

cache
{
    grad(U);
}

