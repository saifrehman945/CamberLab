FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform ({{ UX }} {{ UY }} 0);

boundaryField
{
    freestream
    {
        type            freestreamVelocity;
        freestreamValue uniform ({{ UX }} {{ UY }} 0);
        value           uniform ({{ UX }} {{ UY }} 0);
    }

    aerofoil
    {
        type            noSlip;
    }

    frontAndBack
    {
        type            empty;
    }
}

