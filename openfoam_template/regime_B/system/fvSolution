FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Regime B (near-stall, SIMPLEC). The y+<1 mesh has very high-aspect-ratio
// wall cells (~25k at mid-chord), which makes the pressure Poisson system
// stiff/ill-conditioned. Aggressive relaxation (an earlier p=0.7/U=0.9 trial)
// diverged within ~8 iterations as GAMG failed to solve p. Relaxation is held
// conservative — near the values that ran stably for 5000 iters (p~0.2/U~0.5)
// but with p nudged up so SIMPLEC's pressure step is not over-starved. Raise
// U toward 0.7 only once a run is confirmed stable. The spurious separated
// branch is addressed by the finer near-wall mesh + seeded nut, not by hot
// relaxation. nNonOrthogonalCorrectors = 2 for the mesh's non-orthogonality.

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-08;
        relTol          0.01;
    }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-08;
        relTol          0.1;
    }

    Phi
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-06;
        relTol          0.01;
    }
}

potentialFlow
{
    nNonOrthogonalCorrectors 5;
}

SIMPLE
{
    nNonOrthogonalCorrectors 2;
    consistent               yes;

    residualControl
    {
        p               1e-5;
        U               1e-5;
        k               1e-5;
        omega           1e-5;
    }
}

relaxationFactors
{
    fields
    {
        p               0.3;
    }

    equations
    {
        U               0.5;
        k               0.5;
        omega           0.5;
    }
}

cache
{
    grad(U);
}

