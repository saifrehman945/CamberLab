FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// kOmegaSST specific dissipation rate.
// Freestream omega_inf = sqrt(k_inf) / (C_mu^0.25 * L_t) with
// L_t = 0.07 * chord and C_mu = 0.09 (build_render_context). The
// omegaWallFunction at the wall is valid in both low-Re and high-Re
// limits, so this BC is correct for the y+<1 mesh of Regime B.

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform {{ OMEGAINF }};

boundaryField
{
    freestream
    {
        type            inletOutlet;
        inletValue      uniform {{ OMEGAINF }};
        value           uniform {{ OMEGAINF }};
    }

    aerofoil
    {
        type            omegaWallFunction;
        value           uniform 1;
    }

    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
