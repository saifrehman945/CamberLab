FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// kOmegaSST turbulent kinetic energy.
// Freestream k_inf = 1.5 * (U_inf * Tu)^2 with Tu = 0.01 (set in
// scripts/04_run_cfd.py::build_render_context). Wall value (1e-10) is the
// low-Re wall-function convention and does not depend on freestream.

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform {{ KINF }};

boundaryField
{
    freestream
    {
        type            inletOutlet;
        inletValue      uniform {{ KINF }};
        value           uniform {{ KINF }};
    }

    aerofoil
    {
        type            kLowReWallFunction;
        value           uniform 1e-10;
    }

    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
